# ---- Supp Live (room mode) ----
# Create a free project at https://supabase.com and copy the values from
# Project Settings → API. No tables needed: the mode only uses Realtime
# broadcast channels and presence.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_PUBLIC_ANON_KEY"

# ---- Cockpit rollout flags ----
# legacy = pp_plans JSON; v2 = pp_content + pp_occurrences (migration in progress)
NEXT_PUBLIC_CONTENT_MODEL="v2"
NEXT_PUBLIC_GAMES_V2="1"

# ---- Server-only (never expose to the browser) ----
PROFESSOR_GATE_CODE="YOUR_TEACHER_GATE_CODE"
PROFESSOR_SESSION_SECRET="YOUR_RANDOM_SESSION_SECRET"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"
PASSAPORTE_API_URL="https://passlearn-odyk.onrender.com"
PASSAPORTE_USERNAME="YOUR_PLATFORM_USERNAME"
PASSAPORTE_PASSWORD="YOUR_PLATFORM_PASSWORD"
CRON_SECRET="YOUR_RANDOM_CRON_SECRET"
