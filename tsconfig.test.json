{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022", "DOM"],
    "outDir": ".test-build",
    "rootDir": "lib",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": ["lib/agenda/**/*.ts", "lib/live/room.ts", "lib/content/**/*.ts", "lib/aula/class-report.ts"]
}
